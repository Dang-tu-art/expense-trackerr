{
  "info": {
    "_postman_id": "expense-tracker-api",
    "name": "Expense Tracker API",
    "description": "Postman Collection for Expense Tracker API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/health",
              "host": ["{{api_url}}"],
              "path": ["api", "health"]
            },
            "description": "Check API health and database connection"
          }
        },
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}",
              "host": ["{{api_url}}"]
            },
            "description": "Get API information and available endpoints"
          }
        }
      ]
    },
    {
      "name": "Expenses - CRUD",
      "item": [
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses"]
            },
            "description": "Retrieve all expenses sorted by date (newest first)"
          }
        },
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"description\": \"Lunch at Restaurant\",\n  \"date\": \"2026-05-12\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/expenses",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses"]
            },
            "description": "Create a new expense record"
          }
        },
        {
          "name": "Get Expense by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/1",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "1"]
            },
            "description": "Get specific expense by ID"
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 75000,\n  \"description\": \"Lunch at Restaurant (Updated)\",\n  \"date\": \"2026-05-12\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/expenses/1",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "1"]
            },
            "description": "Update an existing expense"
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/1",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "1"]
            },
            "description": "Delete an expense record"
          }
        }
      ]
    },
    {
      "name": "Summary & Reports",
      "item": [
        {
          "name": "Daily Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/summary/day?date=2026-05-12",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "summary", "day"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-05-12"
                }
              ]
            },
            "description": "Get daily expense summary"
          }
        },
        {
          "name": "Weekly Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/summary/week?date=2026-05-12",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "summary", "week"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-05-12"
                }
              ]
            },
            "description": "Get weekly expense summary"
          }
        },
        {
          "name": "Monthly Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/summary/month?date=2026-05-12",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "summary", "month"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-05-12"
                }
              ]
            },
            "description": "Get monthly expense summary"
          }
        },
        {
          "name": "Yearly Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/expenses/summary/year?date=2026-05-12",
              "host": ["{{api_url}}"],
              "path": ["api", "expenses", "summary", "year"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-05-12"
                }
              ]
            },
            "description": "Get yearly expense summary"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "api_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ]
}
